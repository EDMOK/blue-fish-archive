# Content-hash filenames (media/、previews/) never change → cache forever.
# HTML 仍然每次向边缘做条件请求(max-age=0),保证新部署立刻生效;
# 只加 s-maxage 让边缘短暂缓存源站响应,减少重复访问的回源等待。
# 脚本/清单同理: 浏览器短缓存 + 边缘缓存,并保留 ETag 校验。
/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

/app.js
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/about.js
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/qr-modal.js
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/stickers/manifest.json
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

# HTML、脚本和清单不是内容哈希文件，不能 immutable；发布更新最多在边缘缓存窗口内可见。

/media/*
  Cache-Control: public, max-age=31536000, immutable

/previews/*
  Cache-Control: public, max-age=31536000, immutable

# 灯箱大图层: 同样由 make_previews.py 生成,文件名稳定,缓存永久
/large/*
  Cache-Control: public, max-age=31536000, immutable

# 品牌素材和互动素材使用一周浏览器缓存，并允许边缘缓存更久。
/logo/*
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800

/memes/*
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800
