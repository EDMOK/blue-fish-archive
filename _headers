# Content-hash filenames (media/、previews/) never change → cache forever.
# 没带内容哈希的文件(HTML/脚本/样式/清单)反过来: 发布新版本必须尽快可见。
# 注意 Cloudflare 的 Browser Cache TTL 会把 max-age 改写成 31 天(这里写的 max-age 可能不生效),
# 所以样式和脚本还要靠 HTML 里的 ?v= 版本号换 URL; 边缘缓存窗口也压到 1 分钟,
# 避免 stale-while-revalidate 把上一个部署的 CSS 继续吐给刚更新过的页面。
/
  Cache-Control: public, max-age=0, s-maxage=60, stale-while-revalidate=60

# 规则必须一条路径一个块：Cloudflare Pages 只会把紧跟其后的头应用到最后一个路径，
# 多路径合并写法会静默失效（实测只有最后一条生效），别图省事合并。
/app.js
  Cache-Control: public, max-age=300, s-maxage=60, stale-while-revalidate=60

/about.js
  Cache-Control: public, max-age=300, s-maxage=60, stale-while-revalidate=60

/qr-modal.js
  Cache-Control: public, max-age=300, s-maxage=60, stale-while-revalidate=60

/styles.css
  Cache-Control: public, max-age=300, s-maxage=60, stale-while-revalidate=60

/stickers/manifest.json
  Cache-Control: public, max-age=300, s-maxage=60, stale-while-revalidate=60

# HTML、脚本和清单不是内容哈希文件，不能 immutable；发布更新最多在边缘缓存窗口内可见。

/media/*
  Cache-Control: public, max-age=31536000, immutable

/previews/*
  Cache-Control: public, max-age=31536000, immutable

# 灯箱大图层: 同样由 make_previews.py 生成,文件名稳定,缓存永久
/large/*
  Cache-Control: public, max-age=31536000, immutable

# 品牌素材和互动素材使用一周浏览器缓存，并允许边缘缓存更久。
/logo/*
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800

/memes/*
  Cache-Control: public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800
